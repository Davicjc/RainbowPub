rules_version = '2';
// Rainbow Pub
// - Cardápio e dados do bar: leitura pública, escrita só da equipe logada (sem auto-cadastro).
// - Pedidos: qualquer pessoa cria, mas só com o bar aceitando pedidos, formato fechado
//   e (com GPS ligado) coordenadas dentro da caixa do bar. Lista/edição só da equipe.
//   O cliente lê o próprio pedido pelo id (acompanhar o status).
// - Modo balcão (config/loja.modoBalcao): o site vira só cardápio, cliente não cria pedido;
//   a equipe lança as vendas do balcão pelo painel (já pagas e entregues).
// - Estoque: só a equipe. A baixa é feita pelo painel (venda no balcão ou pedido em preparo).
service cloud.firestore {
  match /databases/{database}/documents {

    // Equipe = conta logada E com documento em equipe/{uid}. Mesmo que alguém reative o
    // auto-cadastro por engano, conta nova não entra no painel sem estar nessa lista.
    function equipe() {
      return request.auth != null && exists(/databases/$(database)/documents/equipe/$(request.auth.uid));
    }
    function loja() { return get(/databases/$(database)/documents/config/loja).data; }

    match /config/{doc} {
      allow read: if true;
      allow write: if equipe();
    }
    match /categorias/{id} {
      allow read: if true;
      allow write: if equipe();
    }
    match /itens/{id} {
      allow read: if true;
      allow write: if equipe();
    }
    match /fotos/{id} {
      allow read: if true;
      allow write: if equipe();
    }

    function geoOk(d) {
      let g = loja().gps;
      return !g.ativo || (
        d.geo is map
        && d.geo.lat is number && d.geo.lng is number
        && d.geo.lat >= g.caixa.latMin && d.geo.lat <= g.caixa.latMax
        && d.geo.lng >= g.caixa.lngMin && d.geo.lng <= g.caixa.lngMax
      );
    }

    function pedidoValido(d) {
      return d.keys().hasOnly(['nome', 'local', 'obs', 'itens', 'total', 'status', 'pago', 'criadoEm', 'geo', 'noite'])
        && d.keys().hasAll(['nome', 'local', 'itens', 'total', 'status', 'pago', 'criadoEm', 'noite'])
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 40
        && d.local is string && d.local.size() >= 1 && d.local.size() <= 40
        && (!('obs' in d) || (d.obs is string && d.obs.size() <= 240))
        && d.itens is list && d.itens.size() >= 1 && d.itens.size() <= 40
        && d.total is number && d.total > 0 && d.total <= 5000
        && d.status == 'novo'
        && d.pago == false
        && d.criadoEm == request.time
        && d.noite is string && d.noite.size() == 10;
    }

    // Venda lançada pela equipe no modo balcão: já sai paga e entregue.
    function balcaoValido(d) {
      return d.keys().hasOnly(['nome', 'local', 'itens', 'total', 'status', 'pago', 'criadoEm', 'noite', 'origem', 'estoqueBaixado', 'baixa'])
        && d.origem == 'balcao'
        && d.itens is list && d.itens.size() >= 1 && d.itens.size() <= 40
        && d.total is number && d.total > 0 && d.total <= 5000
        && d.status == 'entregue'
        && d.pago == true
        && d.criadoEm == request.time
        && d.noite is string && d.noite.size() == 10;
    }

    match /pedidos/{id} {
      allow get: if true;
      allow list: if equipe();
      allow create: if (equipe() && balcaoValido(request.resource.data))
        || (loja().aceitandoPedidos == true && loja().get('modoBalcao', false) != true
            && pedidoValido(request.resource.data) && geoOk(request.resource.data));
      allow update, delete: if equipe();
    }

    // Controle de estoque: só a equipe vê e mexe (quantidades são dado interno do bar).
    match /estoque/{id} {
      allow read, write: if equipe();
    }

    match /equipe/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if equipe();
    }

    match /{doc=**} {
      allow read, write: if false;
    }
  }
}
